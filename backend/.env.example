PORT=3000
HOST=0.0.0.0
GEMINI_API_KEY=put-your-private-key-here
GEMINI_MODEL=gemini-3.8-flash
# CORS is OFF unless you set an origin. The Android app does not need CORS; only set this for a web client.
# ALLOWED_ORIGIN=https://your-web-client.example.com
# Per-client requests per minute for /api/assistant.
RATE_LIMIT_PER_MINUTE=20
# Set to true ONLY when the server sits behind a reverse proxy you control that sets X-Forwarded-For.
TRUST_PROXY=false
